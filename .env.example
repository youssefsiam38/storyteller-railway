# Local development / testing only. Railway deployments get these from the template.
PORT=8001
HOSTNAME=0.0.0.0
# openssl rand -hex 32
STORYTELLER_SECRET_KEY=replace-with-64-hex-characters
# The wrapper creates this administrator on first boot (before the service is public)
STORYTELLER_ADMIN_USERNAME=admin
STORYTELLER_ADMIN_PASSWORD=replace-with-a-long-random-password
STORYTELLER_ADMIN_EMAIL=you@example.com
STORYTELLER_ADMIN_NAME=Administrator
# Public origin, used for links and the mobile apps
STORYTELLER_WEB_URL=http://localhost:8001
STORYTELLER_LIBRARY_NAME=My Library
STORYTELLER_LOG_LEVEL=info
APP_READY_TIMEOUT=300
